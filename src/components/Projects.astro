---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import cosmosTrakSistema from "../assets/proyectos/cosmos-trak-sistema.png";
import cosmosTrakWeb from "../assets/proyectos/cosmos-trak-web.png";
import CodeCard, { type CodeCardData } from "./CodeCard.astro";

interface Project {
  id: string;
  name: string;
  tags: string[];
  description: string;
  // A real capture, or a code card with the stack when there is none to show.
  media:
    | { image: ImageMetadata; alt: string }
    | { variable: string; stack: CodeCardData };
  problem: string;
  solution: string;
  result: string;
}

const projects: Project[] = [
  {
    id: "cosmos-trak-web",
    name: "Cosmos Trak · Sitio web",
    tags: ["Página web", "Node.js", "MySQL"],
    description:
      "Sitio institucional de Cosmos Trak, empresa paraguaya de rastreo satelital y monitoreo GPS de autos, motos y flotas.",
    media: {
      image: cosmosTrakWeb,
      alt: "Portada del sitio de Cosmos Trak, con el formulario para cotizar.",
    },
    problem:
      "El programador anterior se había ido y la empresa se quedó sin el código de su sitio y sin acceso al hosting.",
    solution:
      "Recuperé el código a partir del sitio publicado, lo llevé a un hosting nuevo y actualicé el dominio en NIC.PY. Después sumé mejoras: cada consulta llega al WhatsApp y al correo de la empresa, hay secciones nuevas para flotas y para vehículos particulares, y las transiciones entre páginas y al desplazarse son más suaves.",
    result:
      "El sitio volvió a estar en línea y hoy me encargo yo de él. Las consultas, que antes no llegaban, ahora entran y se pueden contar, y el sitio ya mide sus visitas con las métricas de Meta.",
  },
  {
    id: "cosmos-trak-sistema",
    name: "Cosmos Trak · Sistema administrativo",
    tags: ["Sistema a medida", "React", "PostgreSQL"],
    description:
      "Sistema web para gestionar los clientes, contratos, cobros e inventario de equipos GPS de Cosmos Trak.",
    media: {
      image: cosmosTrakSistema,
      alt: "Panel del sistema administrativo de Cosmos Trak: porcentaje de atraso en los pagos, meta de ventas del mes y un gráfico con el avance anual de instalaciones de 2024, 2025 y 2026.",
    },
    problem:
      "Toda la gestión de clientes, contratos, cobros e inventario se llevaba en una planilla de Excel.",
    solution:
      "Un sistema web responsive con un rol para cada área (administración, ventas e instalación, y alta en la plataforma de rastreo), donde cada persona carga y ve lo que le corresponde.",
    result:
      "En producción las 24 horas, reemplazando la planilla de Excel: el equipo lo usa todos los días.",
  },
  {
    id: "yeron-promo",
    name: "YERON · Promoción con sorteos",
    tags: ["Promoción", "Next.js", "Electron"],
    description:
      "Plataforma para una promoción de la marca YERON, en la que los consumidores participan cargando la foto de su factura.",
    media: {
      variable: "promocion",
      stack: {
        web: ["Next.js", "TypeScript"],
        baseDeDatos: ["PostgreSQL", "Prisma"],
        facturas: "Cloudflare R2, privado",
        antiRobot: "Cloudflare Turnstile",
        sorteo: "Electron, sin conexión",
        hosting: "Railway",
      },
    },
    problem:
      "Una promoción sin códigos precargados: la única prueba de compra era la foto de la factura, y no había un equipo para revisarlas una por una mientras durara la campaña.",
    solution:
      "El consumidor entra por un QR, se registra y sube la foto de su factura: cada factura válida es un cupón. Controles automáticos frenan las facturas repetidas y los robots. Los sorteos se hacen ante escribanía con una app de escritorio que funciona sin conexión.",
    // shortcut: the campaign closes on 2027-01-15; replace this with its real numbers then.
    result:
      "En línea desde el 15 de octubre de 2026: los consumidores ya participan cargando sus facturas.",
  },
];
---

<section id="proyectos" class="section" aria-labelledby="proyectos-title">
  <div class="container">
    <h2 id="proyectos-title" class="section-title">
      Proyectos
    </h2>
    <div class="projects">
      {projects.map(
        ({ id, name, tags, description, media, problem, solution, result }) => (
          <article class="project" aria-labelledby={`${id}-title`}>
            <div class="project-media">
              {"image" in media ? (
                <Image
                  src={media.image}
                  alt={media.alt}
                  widths={[640, 1280]}
                  sizes="(min-width: 48rem) 36rem, 100vw"
                />
              ) : (
                <CodeCard name={media.variable} data={media.stack} />
              )}
            </div>
            <div>
              <ul class="tags" aria-label="Etiquetas">
                {tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
              <h3 id={`${id}-title`}>{name}</h3>
              <p class="description">{description}</p>
              <dl class="story">
                <div>
                  <dt>Problema</dt>
                  <dd>{problem}</dd>
                </div>
                <div>
                  <dt>Solución</dt>
                  <dd>{solution}</dd>
                </div>
                <div>
                  <dt>Resultado</dt>
                  <dd>{result}</dd>
                </div>
              </dl>
            </div>
          </article>
        ),
      )}
    </div>
    <div class="next-project">
      <p>Siguiente proyecto cargando…</p>
      <div class="progress" aria-hidden="true">
        <span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: clamp(3rem, 8vw, 5rem);
  }

  .project {
    display: grid;
    align-items: center;
    gap: 1.5rem 3rem;
  }

  @media (min-width: 48rem) {
    .project {
      grid-template-columns: 1fr 1fr;
    }

    .project:nth-child(even) .project-media {
      order: 1;
    }
  }

  .project-media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 1px solid rgb(255 255 255 / 6%);
    border-radius: 1rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 0.2rem 0.75rem;
    border: 1px solid rgb(0 240 255 / 35%);
    border-radius: 999px;
    color: var(--color-cyan);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  h3 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .description {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
  }

  .story {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  dt {
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
  }

  .next-project {
    margin-top: clamp(3rem, 8vw, 5rem);
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px dashed rgb(255 255 255 / 15%);
    border-radius: 1rem;
    background: var(--color-surface);
    text-align: center;
  }

  .next-project p {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 700;
  }

  .progress {
    max-width: 32rem;
    height: 0.5rem;
    margin-inline: auto;
    border-radius: 999px;
    background: rgb(255 255 255 / 8%);
  }

  /* Without scroll-driven animations (or with reduced motion) the bar stays still, partly filled. */
  .progress span {
    display: block;
    width: 70%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-violet));
  }

  /* Tied to scroll instead of a timer: it only moves while the user scrolls, so it never loops on its own (WCAG 2.2.2).
     It fills while the whole block enters the screen, which works even when nothing below lets the page scroll further.
     Longhands on purpose: the minifier would merge `animation` + `animation-timeline` into a shorthand Chrome rejects. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .next-project {
        view-timeline-name: --next-project;
      }

      .progress span {
        animation-name: next-project-load;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --next-project;
        animation-range: entry 0% entry 100%;
      }
    }
  }

  @keyframes next-project-load {
    from {
      width: 5%;
    }

    to {
      width: 90%;
    }
  }
</style>
