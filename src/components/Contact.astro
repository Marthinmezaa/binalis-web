---
import { email, emailQuoteUrl, whatsappUrl } from "../contact";
---

<section id="cotizacion" class="section" aria-labelledby="cotizacion-title">
  <div class="container contact reveal">
    <p class="eyebrow">// hablemos</p>
    <h2 id="cotizacion-title" class="section-title">
      Cotizá tu proyecto
    </h2>
    <p class="lead">
      Contame qué necesitás y te respondo con una propuesta y un presupuesto
      claro.
    </p>
    <div class="actions">
      <a class="button button-primary" href={whatsappUrl}>
        Hablemos por WhatsApp
      </a>
      <a class="button button-secondary" href={emailQuoteUrl}>
        Escribime un correo
      </a>
    </div>
    {/* Visible too: the mailto button does nothing on computers without a mail app. */}
    <p class="email">
      <a href={`mailto:${email}`}>{email}</a>
    </p>
  </div>
</section>

<style>
  /* Narrow on purpose: the content is a short centered block, a full-width box only added empty space. */
  .contact {
    width: min(100% - 2 * var(--gutter), 46rem);
    padding: clamp(2rem, 5vw, 3rem) var(--gutter);
    border: 1px solid rgb(0 240 255 / 25%);
    border-radius: 1rem;
    background:
      radial-gradient(circle at top, rgb(0 240 255 / 10%), transparent 70%),
      var(--color-surface);
    text-align: center;
  }

  .section-title {
    margin-bottom: 1rem;
  }

  .lead {
    max-width: 32rem;
    margin: 0 auto 2rem;
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  /* Both ways to quote glow, WhatsApp brighter as the main one, both below the "b". This is the resting state:
     without scroll-driven animations or with reduced motion they are simply lit. */
  .actions .button-primary {
    box-shadow: 0 0 1.25rem rgb(0 240 255 / 40%);
  }

  .actions .button-secondary {
    box-shadow: 0 0 1rem rgb(0 240 255 / 20%);
  }

  /* They switch on as the section comes into view, then stay lit. Longhands: see .reveal in global.css. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .actions .button {
        animation-name: switch-on;
        animation-timing-function: ease-in;
        animation-fill-mode: backwards;
        animation-timeline: view();
        animation-range: entry 60% cover 45%;
      }
    }
  }

  @keyframes switch-on {
    from {
      box-shadow: none;
    }
  }

  .email {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .email a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-cyan);
  }
</style>
