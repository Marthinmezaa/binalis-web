---
import { email, emailQuoteUrl, whatsappNeeds } from "../contact";
---

<section id="cotizacion" class="section" aria-labelledby="cotizacion-title">
  <div class="container contact reveal">
    <div>
      <p class="eyebrow">// hablemos</p>
      <h2 id="cotizacion-title" class="section-title">
        Cotizá tu proyecto
      </h2>
      <p class="lead">
        Contame qué necesitás y te respondo con una propuesta y un presupuesto
        claro.
      </p>
    </div>
    <div class="ways">
      <p class="ways-label">Elegí qué necesitás y seguimos por WhatsApp</p>
      <div class="actions">
        {whatsappNeeds.map(({ label, url }) => (
          <a class="button button-primary" href={url}>
            {label}
          </a>
        ))}
        <a class="button button-secondary" href={emailQuoteUrl}>
          Escribime un correo
        </a>
      </div>
      {/* Visible too: the mailto button does nothing on computers without a mail app. */}
      <p class="email">
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </div>
</section>

<style>
  /* Same edges as every other block. On wide screens the text and the ways to write fill the width in two columns
     instead of leaving it empty; on phones they stack, centered. */
  .contact {
    display: grid;
    align-items: center;
    gap: 2rem 4rem;
    padding: clamp(2rem, 5vw, 3rem) clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid rgb(0 240 255 / 25%);
    border-radius: 1rem;
    background:
      radial-gradient(circle at top, rgb(0 240 255 / 10%), transparent 70%),
      var(--color-surface);
    text-align: center;
  }

  .section-title {
    margin-bottom: 1rem;
  }

  .lead {
    max-width: 32rem;
    margin: 0 auto;
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: 1fr auto;
      text-align: left;
    }

    .lead {
      margin: 0;
    }
  }

  .ways {
    text-align: center;
  }

  .ways-label {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .actions {
    display: grid;
    gap: 0.75rem;
  }

  /* Both ways to quote glow, WhatsApp brighter as the main one, both below the "b". This is the resting state:
     without scroll-driven animations or with reduced motion they are simply lit. */
  .actions .button-primary {
    --button-glow: 0 0 1.25rem rgb(0 240 255 / 40%);
  }

  .actions .button-secondary {
    box-shadow: 0 0 1rem rgb(0 240 255 / 20%);
  }

  /* They switch on as the section comes into view, then stay lit. Longhands: see .reveal in global.css. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .actions .button {
        animation-name: switch-on;
        animation-timing-function: ease-in;
        animation-fill-mode: backwards;
        animation-timeline: view();
        animation-range: entry 60% cover 45%;
      }

      /* Near the end of the page the animation is still running and would dim the hover glow. */
      .actions .button:hover {
        animation-name: none;
      }
    }
  }

  @keyframes switch-on {
    from {
      box-shadow: none;
    }
  }

  .email {
    margin: 1.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .email a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-cyan);
  }
</style>
