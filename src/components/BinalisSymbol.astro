---
// The "b": the bar is a 1 and the ring is a 0. The ring's left stroke sits exactly on the bar.
---

<svg class="symbol" viewBox="0 0 104 140" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="symbol-gradient" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="var(--color-cyan)"></stop>
      <stop offset="100%" stop-color="var(--color-violet)"></stop>
    </linearGradient>
  </defs>
  <rect
    x="10"
    y="10"
    width="16"
    height="120"
    rx="8"
    fill="url(#symbol-gradient)"
  ></rect>
  <circle
    cx="52"
    cy="88"
    r="34"
    fill="none"
    stroke="url(#symbol-gradient)"
    stroke-width="16"
  ></circle>
</svg>

<style>
  .symbol {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 0.75rem rgb(0 240 255 / 55%))
      drop-shadow(0 0 2.5rem rgb(123 92 255 / 45%));
  }
</style>
