---
const services = [
  {
    title: "Páginas web",
    description:
      "Sitios rápidos, seguros y fáciles de encontrar en Google, pensados para que cada consulta llegue a tu WhatsApp o a tu correo.",
  },
  {
    title: "Sistemas y apps a medida",
    description:
      "Desde CRM y sistemas de gestión hasta automatizaciones con inteligencia artificial: software hecho a la forma de trabajar de tu empresa.",
  },
  {
    title: "Landing pages y promociones",
    description:
      "Páginas para campañas y promociones con registro, carga de comprobantes y controles contra el fraude, listas para salir rápido.",
  },
];
---

<section id="servicios" class="section" aria-labelledby="servicios-title">
  <div class="container">
    <h2 id="servicios-title" class="section-title">
      Servicios
    </h2>
    <ul class="cards">
      {services.map(({ title, description }) => (
        <li class="card">
          <h3>{title}</h3>
          <p>{description}</p>
        </li>
      ))}
    </ul>
    <p class="more">
      ¿Tu idea no entra en ninguna?&nbsp;
      <a href="#cotizacion">Contame y lo vemos juntos.</a>
    </p>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    overflow: hidden;
    padding: 2rem 1.5rem 1.5rem;
    border: 1px solid rgb(255 255 255 / 6%);
    border-radius: 1rem;
    background: var(--color-surface);
  }

  .card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-violet));
  }

  h3 {
    margin: 0 0 0.75rem;
    font-size: 1.375rem;
  }

  p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .more {
    margin-top: 2rem;
    text-align: center;
  }

  .more a {
    color: var(--color-cyan);
    font-weight: 600;
  }
</style>
