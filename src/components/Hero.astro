---
import BinalisSymbol from "./BinalisSymbol.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 id="hero-title">Desarrollo hecho con pasión y al detalle.</h1>
      <p class="hero-subtitle">
        Diseño y programo páginas web, landing pages, sistemas y promociones a
        medida para empresas. Escucho tu necesidad y la convierto en una
        herramienta que realmente funciona.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#cotizacion">
          Cotizá tu proyecto
        </a>
        <a class="button button-secondary" href="#proyectos">
          Ver proyectos
        </a>
      </div>
    </div>
    <div class="hero-symbol">
      <BinalisSymbol />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .hero-inner {
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  @media (min-width: 48rem) {
    .hero-inner {
      grid-template-columns: 3fr 2fr;
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    max-width: 36rem;
    margin-block: 1.25rem 2rem;
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* On phones the symbol sits below the buttons: kept small so Servicios starts within the first scroll. */
  .hero-symbol {
    width: 8rem;
    justify-self: center;
  }

  @media (min-width: 48rem) {
    .hero-symbol {
      width: min(100%, 16rem);
    }
  }
</style>
