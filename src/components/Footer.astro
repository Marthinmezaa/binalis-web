---
import { version } from "../../package.json";
import { email, whatsappUrl } from "../contact";

// shortcut: the year is fixed at build time; the first deploy of each year updates it.
const year = new Date().getFullYear();
---

<footer class="footer">
  {/* The verse the owner received for Binalis: on every page, quiet, closing the site. */}
  <figure class="container verse">
    <blockquote>
      «Venid a mí todos los que estáis trabajados y cargados, y yo os haré
      descansar.»
    </blockquote>
    <figcaption>Mateo 11:28</figcaption>
  </figure>
  <div class="container footer-inner">
    <p class="wordmark">
      bin<span class="wordmark-accent">alis</span>
    </p>
    <ul class="links">
      <li>
        <a href={whatsappUrl}>WhatsApp</a>
      </li>
      <li>
        <a href={`mailto:${email}`}>{email}</a>
      </li>
    </ul>
    <p class="copyright">
      © {year} Binalis · <span class="version">v{version}</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--color-surface);
  }

  .verse {
    margin-block: 0;
    padding-block: 2.5rem 0;
    text-align: center;
  }

  blockquote {
    max-width: 34rem;
    margin: 0 auto;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 1.125rem;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2rem;
  }

  p {
    margin: 0;
  }

  .wordmark {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-text-muted);
  }

  a:hover {
    color: var(--color-text);
  }

  /* release-please bumps package.json on every release, so the footer always shows what is deployed. */
  .version {
    font-family: var(--font-mono);
  }

  .copyright {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>
