---
// The "b" from the brand canvas: the bar is a 1 and the ring is a 0, with the ring touching the bar.
---

<svg class="symbol" viewBox="0 0 120 140" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="symbol-ring-gradient">
      <stop offset="0%" stop-color="var(--color-violet)"></stop>
      <stop offset="100%" stop-color="var(--color-cyan)"></stop>
    </linearGradient>
  </defs>
  <rect
    class="bar"
    x="10"
    y="10"
    width="16"
    height="120"
    rx="8"
    fill="var(--color-cyan)"
  ></rect>
  <circle
    class="ring"
    cx="68"
    cy="88"
    r="34"
    fill="none"
    stroke="url(#symbol-ring-gradient)"
    stroke-width="16"
    pathLength="1"
  ></circle>
</svg>

<style>
  .symbol {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 0 0.5rem rgb(0 240 255 / 35%));
  }

  /* Neon "breathing": a copy with the peak glow fades in and out over the resting "b".
     Fading a layer runs on the compositor; animating the filter itself would repaint on the main thread every frame. */
  .symbol + .symbol {
    position: absolute;
    inset: 0;
    opacity: 0;
    filter: drop-shadow(0 0 1rem rgb(0 240 255 / 55%));
  }

  @media (prefers-reduced-motion: no-preference) {
    .symbol + .symbol {
      animation: glow-pulse 2.4s ease-in-out infinite;
    }
  }

  /* On load the "b" draws itself: the 1 rises, then the 0 closes around it. */
  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: draw-bar 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    /* Backwards fill only: once drawn the ring drops the dash pattern, which would leave a seam where the dash closes. */
    .ring {
      animation: draw-ring 0.9s 0.45s cubic-bezier(0.6, 0, 0.2, 1) backwards;
    }
  }

  @keyframes draw-bar {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes draw-ring {
    from {
      stroke-dasharray: 0 1;
    }

    to {
      stroke-dasharray: 1 0;
    }
  }

  @keyframes glow-pulse {
    50% {
      opacity: 1;
    }
  }
</style>
