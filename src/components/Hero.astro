---
import BinalisSymbol from "./BinalisSymbol.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">// binalis · desarrollo de software</p>
      <h1 id="hero-title">
        Desarrollo hecho con pasión y <span class="accent">al detalle.</span>
      </h1>
      <p class="hero-subtitle">
        Diseño y programo páginas web, landing pages, sistemas y promociones a
        medida para empresas. Escucho tu necesidad y la convierto en una
        herramienta que realmente funciona.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="#cotizacion">
          Cotizá tu proyecto
        </a>
        <a class="button button-secondary" href="#proyectos">
          Ver proyectos
        </a>
      </div>
    </div>
    <figure class="hero-symbol">
      <div class="symbol-box">
        <BinalisSymbol />
      </div>
      <figcaption>// la b de binalis es un 1 y un 0</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  /* Brand atmosphere: violet and cyan glow behind the symbol over a faint grid, fading out at the edges. */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        32rem 26rem at 78% 45%,
        rgb(123 92 255 / 22%),
        transparent 70%
      ),
      radial-gradient(
        22rem 18rem at 75% 50%,
        rgb(0 240 255 / 14%),
        transparent 70%
      ),
      linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px) 0 0 / 3rem
        3rem,
      linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px) 0 0 /
        3rem 3rem;
    mask-image: radial-gradient(
      ellipse 70% 80% at 60% 45%,
      #000 40%,
      transparent 100%
    );
  }

  .hero-inner {
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  @media (min-width: 48rem) {
    /* Most of the screen, centered, with little padding of its own: the next section peeks in to invite scrolling. */
    .hero {
      display: grid;
      align-items: center;
      min-height: min(calc(85svh - var(--header-height)), 48rem);
      padding-block: 2rem;
    }

    .hero-inner {
      grid-template-columns: 3fr 2fr;
    }
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6.5vw, 4.75rem);
    letter-spacing: -0.03em;
  }

  .accent {
    background: linear-gradient(90deg, var(--color-cyan), var(--color-violet));
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    max-width: 36rem;
    margin-block: 1.25rem 2rem;
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* On phones the symbol sits below the buttons, kept small so it doesn't push the content down. */
  .hero-symbol {
    margin: 0;
    justify-self: center;
  }

  .symbol-box {
    width: 8rem;
    margin-inline: auto;
  }

  @media (min-width: 48rem) {
    .symbol-box {
      width: 19rem;
      max-width: 100%;
    }
  }

  figcaption {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-align: center;
  }
</style>
