---
// Absolute anchors ("/#…") so they also work from /quien-soy.
const links = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#proceso", label: "Proceso" },
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/quien-soy/", label: "Quién soy" },
];
---

<header class="header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Binalis, inicio">
      bin<span class="wordmark-accent">alis</span>
    </a>
    <nav aria-label="Principal">
      <ul class="nav-list">
        {links.map(({ href, label }) => (
          <li>
            <a
              class="nav-link"
              href={href}
              aria-current={href === Astro.url.pathname ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="cta button button-primary" href="#cotizacion">
      Cotizá tu proyecto
    </a>
  </div>
</header>

<style>
  /* Sticky so "Cotizá tu proyecto" is always at hand; translucent so the page shows through. */
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    background: rgb(6 8 15 / 80%);
    backdrop-filter: blur(12px);
    /* Lets the CTA know when the header is stuck, i.e. once the visitor scrolls. */
    container-type: scroll-state;
  }

  .header-inner {
    display: grid;
    grid-template-areas:
      "logo cta"
      "nav nav";
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    padding-block: 0.5rem 0;
  }

  @media (min-width: 48rem) {
    .header-inner {
      grid-template-areas: "logo nav cta";
      grid-template-columns: auto 1fr auto;
      gap: 2rem;
      padding-block: 0.75rem;
    }

    nav {
      justify-self: end;
    }
  }

  nav {
    grid-area: nav;
  }

  .cta {
    grid-area: cta;
  }

  /* While scrolling, the CTA breathes like the hero's "b": same rhythm, only the glow changes.
     Browsers without scroll-state queries simply keep it still. */
  @media (prefers-reduced-motion: no-preference) {
    @container scroll-state(stuck: top) {
      .cta {
        animation: cta-glow 2.4s ease-in-out infinite;
      }
    }
  }

  @keyframes cta-glow {
    50% {
      box-shadow: 0 0 1rem rgb(0 240 255 / 40%);
    }
  }

  .wordmark {
    grid-area: logo;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-text);
  }
</style>
