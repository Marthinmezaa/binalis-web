---
// Absolute anchors ("/#…") so they also work from /quien-soy.
const links = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#proceso", label: "Proceso" },
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#quien", label: "Quién soy" },
];
---

<header class="header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Binalis, inicio">
      bin<span class="wordmark-accent">alis</span>
    </a>
    {/* Phones: a native popover menu, so the header fits in one row. Wide screens: always shown inline. */}
    <button
      class="menu-button"
      type="button"
      popovertarget="menu"
      aria-label="Menú"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <nav id="menu" aria-label="Principal" popover>
      <ul class="nav-list">
        {links.map(({ href, label }) => (
          <li>
            <a class="nav-link" href={href}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="cta button button-primary" href="#cotizacion">
      Cotizá tu proyecto
    </a>
  </div>
</header>

<script>
  // The links jump within the page, which doesn't close a popover: the menu closes itself.
  const menu = document.getElementById("menu");
  if (menu) {
    menu.addEventListener("click", (event) => {
      const isLink =
        event.target instanceof Element && event.target.closest("a");
      if (isLink && menu.matches(":popover-open")) menu.hidePopover();
    });
  }
</script>

<style>
  /* Sticky so "Cotizá tu proyecto" is always at hand; translucent so the page shows through. */
  .header {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    background: rgb(6 8 15 / 80%);
    backdrop-filter: blur(12px);
    /* Lets the CTA know when the header is stuck, i.e. once the visitor scrolls. */
    container-type: scroll-state;
  }

  .header-inner {
    display: grid;
    grid-template-areas: "logo cta menu";
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.5rem;
    padding-block: 0.5rem;
  }

  .menu-button {
    grid-area: menu;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 15%);
    border-radius: 0.75rem;
    background: none;
    color: var(--color-text);
    cursor: pointer;
  }

  .menu-button svg {
    width: 1.5rem;
    fill: none;
    stroke: currentcolor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  /* The open menu drops below the header, across the screen, with the same translucent glass. */
  nav:popover-open {
    inset: var(--header-height) 0 auto;
    width: auto;
    margin: 0;
    padding: 0.5rem var(--gutter) 1rem;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 6%);
    background: rgb(6 8 15 / 80%);
    backdrop-filter: blur(12px);
    color: inherit;
  }

  nav:popover-open .nav-list {
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  nav:popover-open .nav-link {
    display: block;
    padding-block: 0.75rem;
    font-size: 1.125rem;
  }

  @media (min-width: 48rem) {
    .header-inner {
      grid-template-areas: "logo nav cta";
      grid-template-columns: auto 1fr auto;
      gap: 2rem;
      padding-block: 0.75rem;
    }

    .menu-button {
      display: none;
    }

    /* Undoes the browser's popover styles: here the nav is part of the header. */
    nav[popover] {
      display: block;
      position: static;
      justify-self: end;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      border: 0;
      background: none;
      color: inherit;
    }
  }

  nav {
    grid-area: nav;
  }

  /* A bit smaller on phones, so it stays on one line next to the logo and the menu down to 360px. */
  .cta {
    grid-area: cta;
    padding-inline: 1rem;
    font-size: 0.875rem;
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .cta {
      padding-inline: 1.25rem;
      font-size: 1rem;
    }
  }

  /* While scrolling, the CTA breathes like the hero's "b": same rhythm, only the glow changes.
     Browsers without scroll-state queries simply keep it still. */
  @media (prefers-reduced-motion: no-preference) {
    @container scroll-state(stuck: top) {
      .cta {
        animation: cta-glow 2.4s ease-in-out infinite;
      }
    }
  }

  @keyframes cta-glow {
    50% {
      box-shadow: 0 0 1rem rgb(0 240 255 / 40%);
    }
  }

  .wordmark {
    grid-area: logo;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text);
  }
</style>
