---
import { whatsappUrl } from "../contact";

// shortcut: the year is fixed at build time; the first deploy of each year updates it.
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="wordmark">
      bin<span class="wordmark-accent">alis</span>
    </p>
    <ul class="links">
      <li>
        <a href={whatsappUrl}>WhatsApp</a>
      </li>
    </ul>
    <p class="copyright">© {year} Binalis</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--color-surface);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2rem;
  }

  p {
    margin: 0;
  }

  .wordmark {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--color-text-muted);
  }

  a:hover {
    color: var(--color-text);
  }

  .copyright {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
</style>
